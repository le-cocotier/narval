# Maintainer: Arthur Barraux <arthurbarraux@icloud.com>
#
# AUR package "narval-editor" (formerly "beluga-editor", from before the
# editor was renamed). packaging/render.sh VERSION fills in pkgver and sha256sums;
# regenerate .SRCINFO with: makepkg --printsrcinfo > .SRCINFO
pkgname=narval-editor
pkgver=@VERSION@
pkgrel=1
pkgdesc="Terminal text editor configured in Lisp, with LSP and a debugger"
arch=('x86_64' 'aarch64')
url="https://git.giorgio-nas.fr/arthur/narval"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'ninja')
checkdepends=('git')
optdepends=('git: git integration, project search in repositories'
            'gdb: debugging C programs'
            'clangd: C language server')
provides=('narval')
conflicts=('narval' 'beluga-editor')
replaces=('beluga-editor')
source=("narval-$pkgver.tar.gz::$url/releases/download/v$pkgver/narval-$pkgver.tar.gz")
sha256sums=('@SHA256_SOURCE@')

build() {
  arch-meson "narval-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-suite pty
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "narval-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
