# Valgrind suppressions for narval-gui: what SDL's X11 video driver leaves
# behind in Xlib (the input method and resource database it opens once per
# process). See tools/lsan-gui.supp. Usage:
#   valgrind --leak-check=full --suppressions=tools/valgrind-gui.supp build/narval-gui
{
   sdl-x11-input-method
   Memcheck:Leak
   ...
   fun:X11_InitKeyboard
}
{
   sdl-x11-content-scale
   Memcheck:Leak
   ...
   fun:GetGlobalContentScale
}
